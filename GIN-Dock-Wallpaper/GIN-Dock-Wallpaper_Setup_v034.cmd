<# :
@echo off
setlocal DisableDelayedExpansion
title GIN Dock Wallpaper Setup v034 [VladiMIR + Antigravity]

net session >nul 2>&1
if %errorlevel% equ 0 goto :RUN_INSTALLER

if not defined GIN_SETUP_ELEVATED (
    set GIN_SETUP_ELEVATED=1
    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "try { Start-Process '%~f0' -Verb RunAs -ErrorAction Stop; exit 0 } catch { exit 1 }" >nul 2>&1
    if not errorlevel 1 exit /b 0
)

:RUN_INSTALLER
set "SCRIPT_FILE=%~f0"
set "PS_EXE=powershell.exe"
if exist "%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" set "PS_EXE=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"

"%PS_EXE%" -NoProfile -ExecutionPolicy Bypass -Command "$f = $env:SCRIPT_FILE; if (-not $f) { $f = '%~f0' }; $raw = [System.IO.File]::ReadAllText($f, [System.Text.Encoding]::UTF8); try { & ([ScriptBlock]::Create($raw)) } catch { [Console]::WriteLine('`n[X] INSTALL ERROR: ' + $_.Exception.Message) }"

timeout /t 3 >nul 2>&1
exit /b 0
#>
# ==============================================================================
# GIN Dock Wallpaper Setup v034 (Self-Contained Hybrid Installer)
# Author: Vladimir Bulantsev (@GinCz) & Antigravity
# ==============================================================================
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$Host.UI.RawUI.WindowTitle = "GIN Dock Wallpaper Setup v034"

Write-Host "===============================================================================" -ForegroundColor Cyan
Write-Host "         ⚡ GIN Dock Wallpaper — Hot-Corner Dock & 4K Wallpaper HUD            " -ForegroundColor Yellow
Write-Host "                     Version: v034 (Enhanced Release)                          " -ForegroundColor Green
Write-Host "               Author: Vladimir Bulantsev (@GinCz) & Antigravity               " -ForegroundColor White
Write-Host "===============================================================================" -ForegroundColor Cyan
Write-Host ""

$tempExe = "$env:TEMP\GIN-Dock-Wallpaper_v034_Setup.exe"
$b64 = @"

"@

Write-Host "[*] Extracting setup engine..." -ForegroundColor Gray
[System.IO.File]::WriteAllBytes($tempExe, [System.Convert]::FromBase64String($b64))

Write-Host "[*] Executing installer..." -ForegroundColor Green
Start-Process -FilePath $tempExe -Wait

Remove-Item -Path $tempExe -Force -ErrorAction SilentlyContinue
Write-Host "[OK] Installation finished." -ForegroundColor Cyan
